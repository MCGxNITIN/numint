# Numint configuration. Copy this file to .env, or use `numint config set <KEY> <value>`.
# The tool runs fully with NO keys (offline baseline). Keys just unlock more data.

# --- Data providers (all have free tiers) ---------------------------------
# Numverify (APILayer), free ~100 req/mo, https://numverify.com/product
NUMVERIFY_API_KEY=

# Veriphone, free tier, https://veriphone.io/
VERIPHONE_API_KEY=

# AbstractAPI Phone Validation, free tier, https://www.abstractapi.com/phone-validation-api
ABSTRACTAPI_API_KEY=

# NumLookupAPI, free tier, https://www.numlookupapi.com/
NUMLOOKUPAPI_API_KEY=

# IPQualityScore (IPQS), free tier, https://www.ipqualityscore.com/create-account
# This is the fraud / spam / risk reputation layer.
IPQS_API_KEY=

# Twilio Lookup, optional / advanced (free trial credit), https://www.twilio.com/try-twilio
# Needs BOTH values. Adds line type intelligence and caller name (CNAM).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Discord (optional) ---------------------------------------------------
# Webhook: push a scan result into a channel. Make one in the channel settings.
DISCORD_WEBHOOK_URL=

# Bot: run /scan from Discord. Needs `pip install "numint[discord]"`.
# Get a token at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# --- AI summary layer (optional) ------------------------------------------
# Pick ONE provider and set its key. If unset, the AI layer stays off.
# AI_PROVIDER = openai | anthropic | gemini
AI_PROVIDER=
# Optional model override (otherwise a sensible default per provider is used).
# openai -> gpt-4o-mini, anthropic -> claude-sonnet-5, gemini -> gemini-1.5-flash
AI_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Behavior tuning (optional) -------------------------------------------
# Cache TTL in seconds (default 86400 = 1 day).
NUMINT_CACHE_TTL=86400
# Per-provider timeout in seconds (default 10).
NUMINT_PROVIDER_TIMEOUT=10
# Per-provider rate limit, requests/sec (default 3).
NUMINT_RATE_LIMIT=3
# Log level: DEBUG | INFO | WARNING | ERROR (default WARNING).
NUMINT_LOG_LEVEL=WARNING
